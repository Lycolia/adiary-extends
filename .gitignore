# adiary files
#--------------------------------------
!/info/
!/lib/
!/plugin/
!/skel/
!/t/

#--------------------------------------
# public directory
#--------------------------------------
!/pub/
/pub/*
!/pub/.gitkeep
!/pub/assets/

#--------------------------------------
# private directory
#--------------------------------------
!/__cache/.htaccess
!/__cache/index.html

!/data/.htaccess
!/data/index.html

!/skel.local/.htaccess
!/skel.local/README.txt

#--------------------------------------
# ignore files

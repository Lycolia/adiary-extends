#--------------------------------------
# ignore default
#--------------------------------------
/*

# VSCode config
!.vscode/*.json

# github files
!/.github

#--------------------------------------
# root files
#--------------------------------------
!/lyndbaum.cgi
!/lyndbaum.fcgi
!/lyndbaum.env.cgi.sample
!/lyndbaum.conf.cgi.sample
!/lyndbaum.httpd.pl
!/CHANGES.txt
!/index.html
!/README.md
!/docs/


use strict;
#-------------------------------------------------------------------------------
# 見出しの識別子の書き足し（記事の保存時の add_heading_ids と Ver3.53 の書き換え）のテスト
#-------------------------------------------------------------------------------
# 実行: prove -Ilib t/heading_id.t
#
use FindBin;
use lib "$FindBin::Bin/lib";
BEGIN { push(@INC, "$FindBin::Bin/../lib"); }
use Test::More;
use MarkdownTest qw(new_parser);

use SatsukiApp::adiary_6 ();

# 旧データの書き換え（Ver3.53）。今の見出しのIDを書き足す
sub freeze { return SatsukiApp::adiary->freeze_heading_ids_353(new_parser(), $_[0]); }
# 記事の保存。新しい識別子を書き足す（比べやすいよう識別子を順に n1, n2 … に置き換える）
sub add {
	my $n = 0;
	(my $r = new_parser()->add_heading_ids($_[0])) =~ s/\[#[a-z][0-9a-f]{7}\]/'[#n' . ++$n . ']'/eg;
	return $r;
}

is(freeze("# 見出し\n\n本文\n\n## 小見出し"),
	"# 見出し [#見出し]\n\n本文\n\n## 小見出し [#小見出し]",
	'今のIDを識別子として書き足す');

is(freeze("## まとめ\n\n## まとめ"),
	"## まとめ [#まとめ]\n\n## まとめ [#まとめ-2]",
	'同じ文字の見出しは、今のIDと同じく -2 を付ける');

is(add("## 見出し [#abc]\n\n## 次"),
	"## 見出し [#abc]\n\n## 次 [#n1]",
	'識別子のある見出しには書き足さない');

is(add("```\n# コメント\n```\n\n## 見出し"),
	"```\n# コメント\n```\n\n## 見出し [#n1]",
	'コードフェンスの中には書き足さない');

is(add("- 項目\n\n  ## 項目の中\n- 項目\n## 項目の続き\n\n## 見出し"),
	"- 項目\n\n  ## 項目の中\n- 項目\n## 項目の続き\n\n## 見出し [#n1]",
	'リストの中の # は見出しではないので書き足さない');

is(add("> ## 引用の中の見出し\n\n## 見出し"),
	"> ## 引用の中の見出し\n\n## 見出し [#n1]",
	'引用の中の見出しには書き足さない');

is(add("> 引用\n## 引用の続きの見出し\n\n## 見出し"),
	"> 引用\n## 引用の続きの見出し\n\n## 見出し [#n1]",
	'> の無い行も、空行までは引用の中');

is(freeze("> ## 引用の中の見出し\n\n## 見出し"),
	"> ## 引用の中の見出し\n\n## 見出し [#見出し]",
	'Ver3.53でも引用の中の見出しには書き足さない');

is(add("## 見出し\n\n本文[^1]\n\n[^1]: 脚注\n\n    ## 脚注の中"),
	"## 見出し [#n1]\n\n本文[^1]\n\n[^1]: 脚注\n\n    ## 脚注の中",
	'脚注の中の # は見出しではないので書き足さない');

is(add("本文だけ"), "本文だけ", '見出しが無ければそのまま');

is(add("  ## 文章\n\n## 見出し"), "  ## 文章\n\n## 見出し [#n1]", '行頭に空白のある ## は見出しではないので書き足さない');

# 下線で書いた見出し（本文の次の行の ---）は行を見ても見つからないので、見出しの数が合わない
is(add("本文\n---\n\n## 見出し"), "本文\n---\n\n## 見出し", '見出しの数が合わなければ書き足さない');

is(add("## 見出し"), "## 見出し [#n1]", '見出しの文字とは関係のない識別子を書き足す');

is(add("## 見出し\n\n[見出しへ](#見出し)"), "## 見出し\n\n[見出しへ](#見出し)",
	'記事の中から見出しへのリンクがあれば書き足さない（リンクが切れるため）');

is(add("## 見出し\n\n[ほかの記事](/0002#見出し)"), "## 見出し [#n1]\n\n[ほかの記事](/0002#見出し)",
	'ほかの記事へのリンクは関係ない');

{
	my $p = new_parser();
	my $text = "## 見出し\n\n本文";
	my $before = $p->parse($text);
	my $new = freeze($text);
	is(scalar $p->parse($new), $before, '今のIDを書き足す前と後でHTMLが同じ');
	(my $renamed = $new) =~ s/## 見出し/## 名前を変えた見出し/;
	like(scalar $p->parse($renamed), qr/<h4 id="見出し">/, '書き足した後は、見出しの文字を変えてもIDが変わらない');
}

{
	my $p = new_parser();
	my %used = ('a0000000' => 1);
	my $id = $p->new_heading_id(\%used);
	like($id, qr/^[a-z][0-9a-f]{7}$/, '新しい識別子は英字1文字と16進数7桁');
	isnt($id, 'a0000000', '使っている識別子は避ける');
}

done_testing;
